{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenroom.example/schemas/persona-0.1.schema.json",
  "title": "Green Room persona manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "author",
    "license",
    "summary",
    "identity",
    "behavior",
    "knowledge",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "license": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{1,63}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "age_band", "setting"],
      "properties": {
        "type": {
          "enum": ["original", "historical", "historical_interpretation"]
        },
        "age_band": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "setting": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initiative",
        "interruption",
        "verbosity",
        "agreeableness",
        "emotional_range",
        "max_consecutive_turns"
      ],
      "properties": {
        "initiative": {"type": "number", "minimum": 0, "maximum": 1},
        "interruption": {"type": "number", "minimum": 0, "maximum": 1},
        "verbosity": {"type": "number", "minimum": 0, "maximum": 1},
        "agreeableness": {"type": "number", "minimum": 0, "maximum": 1},
        "emotional_range": {"type": "number", "minimum": 0, "maximum": 1},
        "max_consecutive_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cutoff", "domains", "limitations"],
      "properties": {
        "cutoff": {
          "type": "string",
          "format": "date",
          "maxLength": 10
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_tools", "impersonates_real_person", "copied_dialogue"],
      "properties": {
        "external_tools": {"const": false},
        "impersonates_real_person": {"type": "boolean"},
        "copied_dialogue": {"const": false}
      }
    },
    "assets": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "source", "creator"],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^assets/[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,63})*$"
          },
          "source": {"type": "string", "minLength": 1, "maxLength": 256},
          "creator": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenroom.local/schemas/memory/1.0/import-request.schema.json",
  "title": "Green Room import request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "operation",
    "idempotency_key",
    "request_digest",
    "bundle_sha256",
    "bundle_bytes",
    "dry_run",
    "if_room_generations"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {
      "const": "import"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bundle_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "dry_run": {
      "type": "boolean"
    },
    "if_room_generations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "room_id",
          "if_room_generation"
        ],
        "properties": {
          "room_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "if_room_generation": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenroom.local/schemas/memory/1.0/export-manifest.schema.json",
  "title": "Green Room deterministic memory export manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "storage_version",
    "export_id",
    "created_at",
    "snapshot_digest",
    "scope",
    "classifications",
    "rooms",
    "snapshots",
    "counts",
    "entries"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "storage_version": {"type": "integer", "minimum": 1},
    "export_id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/time"},
    "snapshot_digest": {"$ref": "#/$defs/digest"},
    "scope": {"enum": ["derived_only", "events_and_derived"]},
    "classifications": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["private", "room", "exportable"]}},
    "rooms": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["room_id", "room_generation", "as_of_event_sequence", "policy_snapshot_digest", "provider_context_snapshot_digest"],
        "properties": {
          "room_id": {"$ref": "#/$defs/id"},
          "room_generation": {"type": "integer", "minimum": 0},
          "as_of_event_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "policy_snapshot_digest": {"$ref": "#/$defs/digest"},
          "provider_context_snapshot_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rooms", "events", "record_revisions", "active_records", "tombstones"],
      "properties": {
        "rooms": {"type": "integer", "minimum": 1, "maximum": 1000},
        "events": {"type": "integer", "minimum": 0, "maximum": 100000},
        "record_revisions": {"type": "integer", "minimum": 0, "maximum": 100000},
        "active_records": {"type": "integer", "minimum": 0, "maximum": 100000},
        "tombstones": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "items"],
        "properties": {
          "path": {"type": "string", "pattern": "^rooms/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/(events|records)\\.ndjson$", "maxLength": 256},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
          "sha256": {"$ref": "#/$defs/digest"},
          "items": {"type": "integer", "minimum": 0, "maximum": 100000}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenroom.local/schemas/memory/1.0/export-manifest.schema.json",
  "title": "Green Room deterministic memory export manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "export_id", "created_at", "scope", "rooms", "entries"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "export_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"},
    "scope": {"enum": ["derived_only", "events_and_derived"]},
    "rooms": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 2001,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256", "records"],
        "properties": {
          "path": {"type": "string", "pattern": "^rooms/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/(events|records)\\.ndjson$", "maxLength": 256},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "records": {"type": "integer", "minimum": 0, "maximum": 100000}
        }
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}
}

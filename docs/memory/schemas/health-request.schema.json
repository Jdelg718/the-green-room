{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenroom.local/schemas/memory/1.0/health-request.schema.json",
  "title": "Green Room health request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "operation"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {
      "const": "health"
    }
  }
}

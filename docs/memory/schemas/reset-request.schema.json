{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenroom.local/schemas/memory/1.0/reset-request.schema.json",
  "title": "Green Room reset request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "operation",
    "idempotency_key",
    "request_digest",
    "room_id",
    "scope",
    "preserve_events",
    "if_room_generation"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {
      "const": "reset"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "room_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kinds",
        "classifications"
      ],
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "enum": [
              "room",
              "persona",
              "relationship",
              "episode"
            ]
          }
        },
        "classifications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "enum": [
              "private",
              "room",
              "exportable"
            ]
          }
        }
      }
    },
    "preserve_events": {
      "const": true
    },
    "if_room_generation": {
      "type": "integer",
      "minimum": 0
    }
  }
}

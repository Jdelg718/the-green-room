{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenroom.local/schemas/memory/1.0/get-events-response.schema.json",
  "title": "Green Room get_events response 1.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation_id",
        "operation",
        "status",
        "events",
        "cursor",
        "snapshot_room_generation",
        "items_returned",
        "bytes_returned",
        "truncated"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "status": {
          "const": "ok"
        },
        "operation": {
          "const": "get_events"
        },
        "events": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://greenroom.local/schemas/memory/1.0/event.schema.json",
            "title": "Green Room immutable room event 1.0",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contract_version",
              "event_id",
              "room_id",
              "event_sequence",
              "occurred_at",
              "kind",
              "actor_id",
              "visibility",
              "payload",
              "content_digest"
            ],
            "properties": {
              "contract_version": {
                "const": "1.0"
              },
              "event_id": {
                "$ref": "#/$defs/id"
              },
              "room_id": {
                "$ref": "#/$defs/id"
              },
              "event_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "occurred_at": {
                "$ref": "#/$defs/time"
              },
              "kind": {
                "enum": [
                  "speech",
                  "reaction",
                  "control",
                  "scene",
                  "membership"
                ]
              },
              "actor_id": {
                "$ref": "#/$defs/id"
              },
              "visibility": {
                "enum": [
                  "room",
                  "participants",
                  "private_user"
                ]
              },
              "payload": {
                "type": "object",
                "maxProperties": 32,
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "null"
                  ]
                }
              },
              "content_digest": {
                "$ref": "#/$defs/digest"
              }
            },
            "$defs": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "time": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "snapshot_room_generation": {
          "type": "integer",
          "minimum": 0
        },
        "items_returned": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_returned": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation_id",
        "operation",
        "status",
        "error"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "operation": {
          "const": "get_events"
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "operation_id"
          ],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "unsupported",
                "timeout",
                "unavailable",
                "internal_error",
                "not_found",
                "budget_exceeded",
                "migration_required",
                "corrupt_store"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "retryable": {
              "type": "boolean"
            },
            "operation_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "current_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "current_room_generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "migration_required": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  ]
}

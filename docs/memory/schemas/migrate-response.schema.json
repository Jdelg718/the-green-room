{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenroom.local/schemas/memory/1.0/migrate-response.schema.json",
  "title": "Green Room migrate response 1.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation_id",
        "operation",
        "status",
        "commit_id",
        "storage_version",
        "completed_steps",
        "verification_digest"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "status": {
          "const": "ok"
        },
        "operation": {
          "const": "migrate"
        },
        "commit_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "storage_version": {
          "type": "integer",
          "minimum": 1
        },
        "completed_steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "verification_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation_id",
        "operation",
        "status",
        "error"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "operation": {
          "const": "migrate"
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "operation_id"
          ],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "unsupported",
                "timeout",
                "unavailable",
                "internal_error",
                "conflict",
                "idempotency_mismatch",
                "read_only",
                "migration_required",
                "corrupt_store",
                "auth_failed"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "retryable": {
              "type": "boolean"
            },
            "operation_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "current_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "current_room_generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "migration_required": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenroom.local/schemas/memory/1.0/export-request.schema.json",
  "title": "Green Room export request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "operation",
    "room_ids",
    "scope",
    "classifications",
    "snapshots"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {
      "const": "export"
    },
    "room_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "scope": {
      "enum": [
        "derived_only",
        "events_and_derived"
      ]
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "private",
          "room",
          "exportable"
        ]
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "room_id",
          "room_generation",
          "as_of_event_sequence",
          "policy_snapshot_digest",
          "provider_context_snapshot_digest"
        ],
        "properties": {
          "room_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "room_generation": {
            "type": "integer",
            "minimum": 0
          },
          "as_of_event_sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "policy_snapshot_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "provider_context_snapshot_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}

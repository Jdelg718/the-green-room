{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenroom.local/schemas/memory/1.0/retrieve-request.schema.json",
  "title": "Green Room retrieve request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "operation",
    "room_id",
    "query",
    "kinds",
    "classifications",
    "as_of_event_sequence",
    "budget"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {
      "const": "retrieve"
    },
    "room_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_persona_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target_persona_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "query": {
      "type": "string",
      "maxLength": 4096
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "enum": [
          "room",
          "persona",
          "relationship",
          "episode"
        ]
      }
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "enum": [
          "private",
          "room",
          "exportable"
        ]
      }
    },
    "as_of_event_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_items",
        "max_total_bytes",
        "max_item_bytes",
        "timeout_ms"
      ],
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "max_item_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 10,
          "maximum": 2000
        }
      }
    }
  },
  "oneOf": [
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "persona_id"
            ]
          },
          {
            "required": [
              "source_persona_id"
            ]
          },
          {
            "required": [
              "target_persona_id"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "persona_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "source_persona_id"
            ]
          },
          {
            "required": [
              "target_persona_id"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "source_persona_id",
        "target_persona_id"
      ],
      "not": {
        "required": [
          "persona_id"
        ]
      }
    }
  ]
}

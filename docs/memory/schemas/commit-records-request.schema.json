{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenroom.local/schemas/memory/1.0/commit-records-request.schema.json",
  "title": "Green Room commit_records request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "operation",
    "idempotency_key",
    "request_digest",
    "room_id",
    "writes"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {
      "const": "commit_records"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "room_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "writes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record",
          "if_revision"
        ],
        "properties": {
          "record": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://greenroom.local/schemas/memory/1.0/record.schema.json",
            "title": "Green Room derived memory revision 1.0",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contract_version",
              "record_id",
              "revision_id",
              "revision",
              "room_id",
              "kind",
              "scope",
              "status",
              "provenance",
              "created_at",
              "created_by"
            ],
            "properties": {
              "contract_version": {
                "const": "1.0"
              },
              "record_id": {
                "$ref": "#/$defs/id"
              },
              "revision_id": {
                "$ref": "#/$defs/id"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "room_id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "enum": [
                  "room",
                  "persona",
                  "relationship",
                  "episode"
                ]
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "persona_id": {
                    "$ref": "#/$defs/id"
                  },
                  "source_persona_id": {
                    "$ref": "#/$defs/id"
                  },
                  "target_persona_id": {
                    "$ref": "#/$defs/id"
                  },
                  "event_range": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "first_event_id",
                      "last_event_id"
                    ],
                    "properties": {
                      "first_event_id": {
                        "$ref": "#/$defs/id"
                      },
                      "last_event_id": {
                        "$ref": "#/$defs/id"
                      }
                    }
                  }
                }
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "status": {
                "enum": [
                  "active",
                  "tombstoned"
                ]
              },
              "supersedes_revision_id": {
                "$ref": "#/$defs/id"
              },
              "tombstone_reason": {
                "type": "string",
                "maxLength": 512
              },
              "classification": {
                "enum": [
                  "private",
                  "room",
                  "exportable"
                ],
                "default": "private"
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              },
              "created_at": {
                "$ref": "#/$defs/time"
              },
              "created_by": {
                "enum": [
                  "harness",
                  "user",
                  "migration"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "active"
                    }
                  }
                },
                "then": {
                  "required": [
                    "body"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "body"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "room"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "scope": {
                      "maxProperties": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "persona"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "scope": {
                      "required": [
                        "persona_id"
                      ],
                      "minProperties": 1,
                      "maxProperties": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "relationship"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "scope": {
                      "required": [
                        "source_persona_id",
                        "target_persona_id"
                      ],
                      "minProperties": 2,
                      "maxProperties": 2
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "episode"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "scope": {
                      "required": [
                        "event_range"
                      ],
                      "minProperties": 1,
                      "maxProperties": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "provenance": {
                      "properties": {
                        "derivation": {
                          "properties": {
                            "kind": {
                              "const": "correction"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "then": {
                  "required": [
                    "supersedes_revision_id"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "provenance": {
                      "properties": {
                        "derivation": {
                          "properties": {
                            "kind": {
                              "const": "compaction"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "provenance": {
                      "properties": {
                        "derivation": {
                          "required": [
                            "source_revision_ids",
                            "compaction_level",
                            "lineage_digest"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            ],
            "$defs": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "time": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "provenance": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_event_ids",
                  "derivation"
                ],
                "properties": {
                  "source_event_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 256,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/$defs/id"
                    }
                  },
                  "derivation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "producer"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "model_proposal",
                          "human_edit",
                          "import",
                          "compaction",
                          "correction"
                        ]
                      },
                      "producer": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "proposal_id": {
                        "$ref": "#/$defs/id"
                      },
                      "policy_version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "source_revision_ids": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 256,
                        "uniqueItems": true,
                        "items": {
                          "$ref": "#/$defs/id"
                        }
                      },
                      "compaction_level": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 32
                      },
                      "lineage_digest": {
                        "$ref": "#/$defs/digest"
                      }
                    }
                  }
                }
              }
            }
          },
          "if_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "if_room_generation": {
      "type": "integer",
      "minimum": 0
    }
  }
}

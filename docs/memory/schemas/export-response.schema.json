{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenroom.local/schemas/memory/1.0/export-response.schema.json",
  "title": "Green Room export response 1.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation_id",
        "operation",
        "status",
        "export_id",
        "created_at",
        "snapshot_digest",
        "bundle_sha256",
        "bytes",
        "counts"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "status": {
          "const": "ok"
        },
        "operation": {
          "const": "export"
        },
        "export_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "events",
            "record_revisions",
            "active_records",
            "tombstones"
          ],
          "properties": {
            "events": {
              "type": "integer",
              "minimum": 0
            },
            "record_revisions": {
              "type": "integer",
              "minimum": 0
            },
            "active_records": {
              "type": "integer",
              "minimum": 0
            },
            "tombstones": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation_id",
        "operation",
        "status",
        "error"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "operation": {
          "const": "export"
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "operation_id"
          ],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "unsupported",
                "timeout",
                "unavailable",
                "internal_error",
                "not_found",
                "budget_exceeded",
                "migration_required",
                "corrupt_store"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "retryable": {
              "type": "boolean"
            },
            "operation_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "current_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "current_room_generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "migration_required": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  ]
}

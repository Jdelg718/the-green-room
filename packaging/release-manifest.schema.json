{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenroomai.net/schemas/release-manifest-v1.json",
  "title": "The Green Room release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleIdentifier",
    "appVersion",
    "sourceCommit",
    "buildEpoch",
    "targetTriple",
    "runtimes",
    "databaseSchema",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleIdentifier": { "const": "net.greenroomai.GreenRoom" },
    "appVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "buildEpoch": { "type": "integer", "minimum": 0 },
    "targetTriple": { "const": "arm64-apple-darwin" },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeVersion", "pythonVersion", "validatorVersion"],
      "properties": {
        "nodeVersion": { "type": "string", "pattern": "^24\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "pythonVersion": { "type": "string", "pattern": "^3\\.(11|1[2-9]|[2-9][0-9])\\.(0|[1-9][0-9]*)$" },
        "validatorVersion": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "databaseSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "const": 1 },
        "maximum": { "const": 3 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^Contents/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._ +@-]+(?:/[A-Za-z0-9._ +@-]+)*$"
          },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

{
  "name": "the-green-room",
  "version": "0.1.0",
  "private": true,
  "description": "Private-first ensemble conversation playground",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x",
    "npm": "11.19.0"
  },
  "greenroomPackageIdentity": {
    "bundleIdentifier": "net.greenroomai.GreenRoom",
    "releaseManifestSchemaVersion": 1,
    "signedReleaseManifestSchemaVersion": 2,
    "developerIdTeam": "JZ233HBW3Z",
    "macosBuildVersion": "120",
    "pythonVersion": "3.13.13",
    "macosToolchain": {
      "xcodeBuild": "17F113",
      "swift": "Apple Swift version 6.3.3",
      "clang": "Apple clang version 21.0.0 (clang-2100.1.1.101)"
    },
    "nodeRuntime": {
      "version": "24.20.0",
      "architecture": "arm64",
      "sourceUrl": "https://nodejs.org/dist/v24.20.0/node-v24.20.0-darwin-arm64.tar.gz",
      "archiveSha256": "40e5607e5ecb3db9192723776da2d75d966260fc74a7a9e731c1bd67dda96bc8"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "ios:sync": "node scripts/ios/sync.mjs",
    "ios:build": "npm run ios:sync && node scripts/ios/prepare-capacitor-runtime.mjs && node scripts/ios/build-simulator.mjs",
    "ios:test": "npm run build --silent && node scripts/ios/run-ios-test.mjs",
    "ios:verify-bundle": "node scripts/ios/verify-bundle.mjs --source && node scripts/ios/verify-bundle.mjs --app .build/ios/Build/Products/Debug-iphonesimulator/App.app",
    "ios:simulator-offline": "node scripts/ios/run-simulator-offline.mjs",
    "ios:simulator-director": "node scripts/ios/run-simulator-director.mjs",
    "ios:device-smoke": "node scripts/ios/device-smoke.mjs",
    "check:python": "uv run python -m unittest discover -s site/scripts -p 'test_*.py' -q && uv run pytest -q tests docs/programmable-character/test_verify_contract.py && uv run ruff format --check src tests docs/programmable-character/verify_contract.py docs/programmable-character/test_verify_contract.py pyproject.toml && uv run ruff check src tests docs/programmable-character/verify_contract.py docs/programmable-character/test_verify_contract.py pyproject.toml && uv run mypy",
    "check:all": "npm run check && npm run check:python",
    "check:release": "npm run check:all && npm run acceptance",
    "package:validator:macos": "node scripts/package/build-validator.mjs",
    "package:launcher:macos": "node scripts/package/build-launcher.mjs",
    "package:macos:unsigned": "node packaging/macos/assemble-app.mjs",
    "package:macos:signed": "node scripts/package/macos-signing.mjs",
    "notarize:macos": "node scripts/package/macos-notarize.mjs",
    "verify:macos:signed": "node scripts/package/verify-macos-signed.mjs",
    "package:release-evidence": "node scripts/package/generate-release-evidence.mjs",
    "verify:release-evidence": "node scripts/package/verify-release-evidence.mjs",
    "verify:clean-mac-acceptance": "node scripts/package/verify-clean-mac-acceptance.mjs",
    "test:packaging": "node scripts/package/test-packaged-validator.mjs && node scripts/package/test-packaged-runtime.mjs",
    "verify:payload": "node scripts/package/verify-payload.mjs",
    "verify:native-module": "node scripts/package/verify-native-module.mjs",
    "compare:unsigned-builds": "node scripts/package/compare-unsigned-apps.mjs",
    "deploy:site": "wrangler deploy",
    "preflight:source": "node scripts/source-clean-host.mjs",
    "start": "node dist/src/server.js",
    "start:local": "node scripts/start-local.mjs",
    "dev": "npm run build && node --watch dist/src/server.js",
    "acceptance": "node scripts/accept-first-playable.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.1",
    "fastify": "5.12.1",
    "fs-ext": "2.1.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@types/fs-ext": "2.0.3",
    "@types/node": "24.10.1",
    "ajv": "8.20.0",
    "typescript": "5.9.3",
    "wrangler": "4.128.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": false,
    "fs-ext@2.1.1": true,
    "fsevents@2.3.3": false,
    "workerd@1.20260831.1": false
  }
}
